# Copy to .env only for local development. Never commit secrets.
PORT=8090
NODE_ENV=development

# Fixed local Keycloak realm issuer and JWKS URL.
OIDC_ISSUER=http://127.0.0.1:8080/realms/ludbA-bank
OIDC_JWKS_URI=http://127.0.0.1:8080/realms/ludbA-bank/protocol/openid-connect/certs
OIDC_AUDIENCE=ludba-api
OIDC_ALLOWED_CLIENT_ID=ludba-portal
OIDC_ALLOWED_ALGORITHMS=RS256

# MFA claim mapping is intentionally unset until actual Keycloak token
# evidence is inspected. Unset means mfa_verified=false (deny restricted access).
MFA_CLAIM_PATH=
MFA_ACCEPTED_VALUES=[]

OPA_URL=http://127.0.0.1:8181
OPA_DECISION_PATH=/v1/data/access/allow
OPA_TIMEOUT_MS=1500

IDENTITY_STATUS_FILE=./data/identities.json
RESOURCE_CATALOG_FILE=./data/resources.json
VENDOR_GRANTS_FILE=./data/vendor-grants.json
